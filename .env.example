# ============================================
# EXAMOS - Environment Configuration
# ============================================

# Database (SQLite for local dev, PostgreSQL for Docker/production)
# Local: sqlite+aiosqlite:///./examos.db
# Docker: postgresql+asyncpg://examos:examos@postgres:5432/examos
DATABASE_URL=sqlite+aiosqlite:///./examos.db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Gemini API (for AI question generation)
# Leave empty to use fallback template-based generation
GEMINI_API_KEY=

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=10
